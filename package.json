    "test": "npm run test --workspaces",
    "pack:check": "npm pack --workspace @tartlet/protocol --dry-run --json"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "eslint": "^9.39.1",
    "typescript-eslint": "^8.48.0"
  }
}
