{
  "name": "@tartlet/protocol",
  "version": "0.2.0",
  "description": "Shared Zod schemas, TypeScript types, and pure helpers for Tartlet clients and services",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.14.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build",
    "test": "node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "zod": "^4.1.13"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/j-labbe/tartlet-cli",
    "directory": "packages/protocol"
  },
  "publishConfig": {
    "access": "public"
  }
}
