{
  "name": "@tartlet/cli",
  "version": "0.2.0",
  "description": "Sign in and connect to Tartlet VMs",
  "type": "module",
  "license": "Apache-2.0",
  "engines": { "node": ">=22.14.0" },
  "bin": { "tartlet": "dist/main.js" },
  "files": ["dist", "LICENSE"],
  "scripts": {
